{$SITE_ADDRESS:http://localhost} {
    reverse_proxy frontend:80 {
        header_up X-Forwarded-port {http.request.local.port}
    }
}

achat.grooverapp.com {
    reverse_proxy achat-web:8080 {
        header_up X-Real-IP {remote_host}
    }
}

groover.grooverapp.com {
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy groover-web:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up -Forwarded
        header_up -X-Real-IP
    }
}

# Primary Groover origin. Keep legacy subdomain until redirects are reviewed.
grooverapp.com {
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy groover-web:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up -Forwarded
        header_up -X-Real-IP
    }
}
